<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>KLZX Sensi Generator</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(circle at top,#351014,#080808 55%);color:white;font-family:Arial,sans-serif;padding:20px}
.container{max-width:520px;margin:auto}
header{text-align:center;padding:20px}
h1{color:#ff263e;font-size:30px;letter-spacing:2px}
header p{color:#aaa}
.panel{background:#171719;border:1px solid #542029;border-radius:17px;padding:18px;margin-bottom:16px;box-shadow:0 0 20px #ff183515}
label{display:block;margin:15px 0 7px;color:#ddd}
select,input{width:100%;padding:13px;background:#242427;color:white;border:1px solid #63303a;border-radius:9px;outline:none}
select:focus,input:focus{border-color:#ff263e}
button{width:100%;padding:14px;border:0;border-radius:10px;background:linear-gradient(90deg,#a90019,#ff263e);color:white;font-weight:bold;font-size:15px;margin-top:15px;cursor:pointer}
button:active{transform:scale(.98)}
.secondary{background:#29292d;border:1px solid #555}
.stat{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #333}
.value{font-size:21px;color:#ff4358;font-weight:bold}
small{color:#888}
footer{text-align:center;color:#777;padding:20px}
</style>
</head>
<body>
<div class="container">
<header><h1>KLZX SENSI</h1><p>ULTIMATE SENSITIVITY GENERATOR</p><small>FREE FIRE • PERSONALIZADO</small></header>
<div class="panel">
<h3>📱 SEU DISPOSITIVO</h3>
<label>Marca</label>
<select id="brand" onchange="loadModels()">
<option value="Apple">Apple</option><option value="Samsung">Samsung</option><option value="Motorola">Motorola</option><option value="Xiaomi">Xiaomi</option><option value="Redmi">Redmi</option><option value="Realme">Realme</option><option value="Infinix">Infinix</option><option value="Tecno">Tecno</option><option value="ASUS">ASUS</option><option value="POCO">POCO</option><option value="Outro">Outro</option>
</select>
<label>Modelo do celular</label><select id="model"></select>
<label>Ciclo de sensibilidade</label>
<select id="cycle"><option value="stable">Ciclo Estável</option><option value="balanced">Ciclo Equilibrado</option><option value="fast">Ciclo Rápido</option><option value="precision">Ciclo Precisão</option><option value="headshot">Ciclo Capa</option><option value="custom">Ciclo Personalizado</option></select>
<label>Estilo de jogo</label>
<select id="style"><option value="balanced">Equilibrado</option><option value="rush">Rush / Agressivo</option><option value="precision">Precisão</option><option value="drag">Puxada de capa</option></select>
</div>
<div class="panel">
<h3>⚙️ PERSONALIZAÇÃO</h3>
<label>Potência da sensibilidade: <span id="powerText">85</span></label>
<input type="range" id="power" min="50" max="100" value="85" oninput="document.getElementById('powerText').textContent=this.value">
<label>DPI (Android)</label><input type="number" id="dpi" min="300" max="800" value="480">
<small>O DPI não é aplicável ao iPhone.</small>
<button onclick="generate()">⚡ GERAR SENSIBILIDADE</button>
</div>
<div class="panel" id="results"><h3>🎯 RESULTADO KLZX</h3><p style="color:#999">Selecione seu celular e gere sua sensibilidade.</p></div>
<button class="secondary" onclick="copyResults()">📋 COPIAR CONFIGURAÇÕES</button>
<button class="secondary" onclick="resetAll()">↻ REINICIAR</button>
<footer>KLZX SENSI GENERATOR<br>Versão 1.0 • Country</footer>
</div>
<script>
const models={
Apple:["iPhone 11","iPhone 11 Pro","iPhone 11 Pro Max","iPhone 12","iPhone 12 Mini","iPhone 12 Pro","iPhone 12 Pro Max","iPhone 13","iPhone 13 Mini","iPhone 13 Pro","iPhone 13 Pro Max","iPhone 14","iPhone 14 Plus","iPhone 14 Pro","iPhone 14 Pro Max","iPhone 15","iPhone 15 Plus","iPhone 15 Pro","iPhone 15 Pro Max","iPhone 16","iPhone 16 Plus","iPhone 16 Pro","iPhone 16 Pro Max","iPhone 17","iPhone 17 Pro","iPhone 17 Pro Max"],
Samsung:["Galaxy A05","Galaxy A06","Galaxy A15","Galaxy A16","Galaxy A25","Galaxy A26","Galaxy A35","Galaxy A36","Galaxy A54","Galaxy A55","Galaxy A56","Galaxy S21","Galaxy S22","Galaxy S23","Galaxy S24","Galaxy S25","Galaxy S25 Ultra","Galaxy S26"],
Motorola:["Moto G14","Moto G15","Moto G24","Moto G34","Moto G54","Moto G55","Moto G84","Moto G85","Edge 40","Edge 50","Edge 60"],
Xiaomi:["Xiaomi 12","Xiaomi 13","Xiaomi 14","Xiaomi 15","Xiaomi 15 Ultra"],
Redmi:["Redmi 12","Redmi 13","Redmi 14C","Redmi Note 12","Redmi Note 13","Redmi Note 14","Redmi Note 14 Pro"],
Realme:["Realme C51","Realme C53","Realme C55","Realme C61","Realme C63","Realme 11","Realme 12","Realme 13","Realme GT 6"],
Infinix:["Hot 30","Hot 40","Hot 50","Hot 60","Note 30","Note 40","GT 20 Pro"],
Tecno:["Spark 10","Spark 20","Spark 30","Camon 20","Camon 30","Pova 5","Pova 6","Pova 7"],
ASUS:["ROG Phone 6","ROG Phone 7","ROG Phone 8","ROG Phone 9"],
POCO:["POCO X5","POCO X6","POCO X7","POCO F5","POCO F6","POCO F7"],
Outro:["Outro modelo"]};
const $=id=>document.getElementById(id);
function loadModels(){const list=models[$("brand").value]||models.Outro;$("model").innerHTML=list.map(x=>`<option>${x}</option>`).join("")}
loadModels();
let current=null;
function generate(){
const cycles={stable:[175,165,155,145,75,120],balanced:[185,175,165,155,85,130],fast:[195,185,175,165,95,140],precision:[165,155,145,135,65,110],headshot:[195,190,180,170,90,145],custom:[180,170,160,150,80,125]};
const base=[...cycles[$("cycle").value]],adjust={balanced:0,rush:8,precision:-10,drag:5}[$("style").value],factor=Number($("power").value)/85;
current=base.map(v=>Math.max(0,Math.min(200,Math.round(v*factor+adjust))));
const names=["Geral","Red Dot","Mira 2x","Mira 4x","AWM","Olhadinha"],isApple=$("brand").value==="Apple";
$("results").innerHTML=`<h3>🎯 RESULTADO KLZX</h3><p>${$("model").value} • ${$("cycle").selectedOptions[0].text}</p>${names.map((n,i)=>`<div class="stat"><span>${n}</span><span class="value">${current[i]}</span></div>`).join("")}${!isApple?`<div class="stat"><span>DPI sugerido</span><span class="value">${$("dpi").value}</span></div>`:""}<p><small>Valores sugeridos para teste. Ajuste conforme sua preferência e resposta do aparelho.</small></p>`;
}
function copyResults(){
if(!current){alert("Gere uma sensibilidade primeiro!");return}
const names=["Geral","Red Dot","Mira 2x","Mira 4x","AWM","Olhadinha"];
let t="KLZX SENSI GENERATOR\n"+$("model").value+"\n\n";names.forEach((n,i)=>t+=n+": "+current[i]+"\n");if($("brand").value!=="Apple")t+="DPI: "+$("dpi").value;
if(navigator.clipboard?.writeText){navigator.clipboard.writeText(t).then(()=>alert("Configurações copiadas!")).catch(()=>alert(t))}else alert(t);
}
function resetAll(){$("brand").value="Apple";loadModels();$("cycle").value="stable";$("style").value="balanced";$("power").value=85;$("powerText").textContent="85";$("dpi").value=480;current=null;$("results").innerHTML="<h3>🎯 RESULTADO KLZX</h3><p>Gere uma nova sensibilidade.</p>"}
</script>
</body></html>
